<article class="project-card-wrapper">
  <div class="project-card">
    <button
      class="project-card-open"
      type="button"
      data-dialog-open="project-{{ project.id }}-dialog"
      aria-haspopup="dialog"
      aria-controls="project-{{ project.id }}-dialog"
      aria-label="Read more about {{ project.title }}"
    >
      <img
        src="{{ project.image }}"
        alt="Preview of {{ project.title }}"
      />

      <span class="project-card-content">
        <span class="project-card-meta">{{ project.year }}</span>
        <span class="project-card-title">{{ project.title }}</span>
        <span class="project-card-summary">{{ project.short_description }}</span>
      </span>
    </button>
    {% if project.live_url %}
    <a class="project-card-visit" href="{{ project.live_url }}" target="_blank" rel="noreferrer noopener">Visit site <span class="sr-only">(opens in a new tab)</span><span aria-hidden="true">↗</span></a>
    {% endif %}
  </div>

  <dialog
    id="project-{{ project.id }}-dialog"
    class="project-popover"
    aria-labelledby="project-{{ project.id }}-title"
  >
    <div class="project-popover-header">
      <p class="project-popover-label">Project · {{ project.year }}</p>
      <button class="popover-close" type="button" data-dialog-close aria-label="Close {{ project.title }} details" autofocus>×</button>
    </div>
    <h3 id="project-{{ project.id }}-title">{{ project.title }}</h3>
    <p>{{ project.long_description }}</p>
    {% if project.repository_url or project.live_url %}
    <p class="project-popover-links">
      {% if project.repository_url %}
      <a class="link" href="{{ project.repository_url }}" target="_blank" rel="noreferrer noopener">View source <span class="sr-only">(opens in a new tab)</span><span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if project.live_url %}
      <a class="link" href="{{ project.live_url }}" target="_blank" rel="noreferrer noopener">Visit live site <span class="sr-only">(opens in a new tab)</span><span aria-hidden="true">↗</span></a>
      {% endif %}
    </p>
    {% endif %}
  </dialog>
</article>