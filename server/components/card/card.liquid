<article class="project-card-wrapper">
  <button
    class="project-card"
    popovertarget="project-{{ project.id }}-popover"
  >
    <img
      src="{{ project.image }}"
      alt="Screenshot van {{ project.title }}"
    />

    <span class="project-card-content">
      <span class="project-card-meta">{{ project.year }}</span>
      <span class="project-card-title">{{ project.title }}</span>
      <span class="project-card-summary">{{ project.short_description }}</span>
      <span class="project-card-action">Read project <span aria-hidden="true">↗</span></span>
    </span>
  </button>

  <div
    id="project-{{ project.id }}-popover"
    popover
    class="project-popover"
  >
    <div class="project-popover-header">
      <p class="project-popover-label">Project · {{ project.year }}</p>
      <button class="popover-close" popovertarget="project-{{ project.id }}-popover" popovertargetaction="hide" aria-label="Close {{ project.title }} details">×</button>
    </div>
    <h4>{{ project.title }}</h4>
    <p>{{ project.long_description }}</p>

  </div>
</article>
